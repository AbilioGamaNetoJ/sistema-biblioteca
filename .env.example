# Copie este arquivo para .env.local e preencha as credenciais dos serviços.

# Supabase — banco de dados, autenticação e Storage de capas
# (Dashboard Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Google Books API — busca de livros por título, autor ou ISBN
# (Google Cloud Console > APIs e serviços > Credenciais)
# Ative a "Google Books API" no projeto antes de criar a chave.
GOOGLE_BOOKS_API_KEY=sua-chave-da-google-books-api
